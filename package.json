{
  "name": "openmonkey",
  "version": "0.9.1",
  "description": "OpenMonkey - Local AI Agent with Dynamic Personality",
  "main": "dist/main/main.js",
  "author": "OpenMonkey contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antontuzov/OpenMonkey.git"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.test.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "tsx --test test/unit/*.test.ts",
    "test:integration": "node test/integration/run.mjs",
    "download-models": "tsx scripts/download-models.ts",
    "benchmark-model": "tsx scripts/benchmark-model.ts",
    "brand:art": "python3 scripts/make-brand-art.py",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3",
    "package:mac": "npm run build && electron-builder --mac",
    "package:win": "npm run build && electron-builder --win",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "better-sqlite3": "^13.0.3",
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.11",
    "lucide-react": "^1.61.0",
    "node-llama-cpp": "^3.22.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "ai.openmonkey.app",
    "productName": "OpenMonkey",
    "files": [
      "dist/**/*",
      "!dist/**/*.map"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "extendInfo": {
        "NSAppleEventsUsageDescription": "OpenMonkey controls Calendar and Mail only when you ask it to work with them."
      },
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/app-icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "artifactName": "OpenMonkey-${arch}.${ext}",
    "publish": {
      "provider": "github",
      "releaseType": "release"
    }
  }
}
